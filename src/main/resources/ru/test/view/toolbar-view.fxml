<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.test.ui.controllers.ToolbarController"
      spacing="8.0" alignment="CENTER_LEFT">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Button fx:id="loadBtn" text="Загрузить CSV" onAction="#onLoadCsv"/>
    <Button fx:id="saveBtn" text="Сохранить CSV" onAction="#onSaveCsv"/>
    <Separator orientation="VERTICAL"/>
    <MenuButton text="Экспорт графа">
        <items>
            <MenuItem text="Экспорт в JSON (*.json)" onAction="#onExportJson"/>
            <MenuItem text="Экспорт в Binary (*.bin)" onAction="#onExportBinary"/>
        </items>
    </MenuButton>

    <MenuButton text="Импорт графа">
        <items>
            <MenuItem text="Импорт из JSON (*.json)" onAction="#onImportJson"/>
            <MenuItem text="Импорт из Binary (*.bin)" onAction="#onImportBinary"/>
        </items>
    </MenuButton>

    <Button fx:id="addProfileBtn" text="Создать профиль" onAction="#onAddProfile"/>
    <Button fx:id="editBtn" text="Редактировать" onAction="#onEditProfile" disable="true"/>
    <Separator orientation="VERTICAL"/>

    <Label text="Кол-во:"/>
    <TextField fx:id="generateCountField" text="100" prefWidth="65.0"/>
    <Button fx:id="generateBtn" text="Сгенерировать" onAction="#onGenerate"/>
    <Button fx:id="cancelBtn" text="Отмена" onAction="#onCancel" disable="true"/>
</HBox>