<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.test.ui.controllers.StatusController"
      spacing="12.0" alignment="CENTER_RIGHT">
    <padding>
        <Insets top="5.0" right="10.0" bottom="5.0" left="10.0"/>
    </padding>

    <Label fx:id="statusLabel" text="Готов" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    <ProgressBar fx:id="progressBar" prefWidth="180.0" progress="0.0"/>
</HBox>